              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}/stock",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "items", "{{itemId}}", "stock"]
            }
          },
          "response": []
        }
      ]
    },
